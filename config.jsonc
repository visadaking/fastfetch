{
  "display": {
    "separator": " ─ ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "yourname@distro",
      "color": {
        "user": "blue",
        "host": "cyan"
      }
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ System"
    },
    {
      "type": "os",
      "key": "├  OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "├ 󰒋 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "├ 󰧨 DE",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "├ 󱆃 Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "├ 󰆍 Terminal",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "key": "└ 󰝚 Music",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ Hardware"
    },
    {
      "type": "cpu",
      "key": "├ 󰍛 CPU",
      "keyColor": "cyan",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "├ 󰢮 GPU",
      "keyColor": "cyan",
      "temp": true
    },
    {
      "type": "memory",
      "key": "├ 󰑭 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "└ 󰋊 Disk",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ Uptime / Age"
    },
    {
      "type": "uptime",
      "key": "├ 󰔚 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "└ 󰋚 OS Age",
      "keyColor": "blue",
      "text": "birth=$(stat -c %W /etc/machine-id); now=$(date +%s); age=$((now-birth)); days=$((age/86400)); hours=$(((age%86400)/3600)); if [ $days -gt 0 ]; then [ $days -eq 1 ] && echo \"1 day\" || echo \"$days days\"; else [ $hours -eq 1 ] && echo \"1 hour\" || echo \"$hours hours\"; fi"
    },
    "break",
    {
      "type": "colors"
    }
  ]
}
